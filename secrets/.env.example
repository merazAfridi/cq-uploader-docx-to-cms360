# Copy this file to secrets/.env (which is git-ignored), or paste the token in the website's token box.
CMS_API_BASE=https://api.10minuteschool.com
# CMS360 bearer token: Chrome → F12 → Network → any api.10minuteschool.com request → "authorization: Bearer …"
# It changes every 10–30 minutes, so paste a fresh one right before uploading.
CMS_TOKEN=
